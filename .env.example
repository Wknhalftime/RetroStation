DATABASE_URL=postgresql://retrostation:retrostation-dev@localhost:5432/retrostation
AIRWAVE_TOKEN=change-me-before-use
LOG_LEVEL=INFO

# Tune-in streaming: path to liquidsoap.exe (no "\<digit>" anywhere in the path).
# Unset disables streaming. Uncomment only where the file exists: the app refuses to
# start with a LIQUIDSOAP_PATH that is not an existing file.
# LIQUIDSOAP_PATH=D:\liquidsoap\liquidsoap-spike.exe
STREAM_WORK_DIR=var/stream
FFMPEG_PATH=ffmpeg
