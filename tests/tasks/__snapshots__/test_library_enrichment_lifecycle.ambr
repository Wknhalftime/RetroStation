# serializer version: 1
# name: test_mb_enrichment_task_called_after_envelope_closes_its_failure_is_not_recorded
  list([
    dict({
      'completed_at_is_set': False,
      'kind': 'progress',
      'progress_data': dict({
        'current_item': '',
        'processed': 0,
        'total': 0,
      }),
      'status': 'running',
      'task_type': 'library_enrichment',
    }),
    dict({
      'category': 'enrichment',
      'details': dict({
        'batch_count': 0,
        'recording_count': 0,
        'release_count': 0,
      }),
      'kind': 'log',
      'level': 'INFO',
      'message': 'enrichment_started',
    }),
    dict({
      'completed_at_is_set': True,
      'kind': 'progress',
      'progress_data': dict({
        'enriched': 0,
        'failed': 0,
        'processed': 0,
        'total': 0,
      }),
      'status': 'completed',
      'task_type': 'library_enrichment',
    }),
    dict({
      'category': 'enrichment',
      'details': dict({
        'enriched': 0,
        'failed': 0,
      }),
      'kind': 'log',
      'level': 'INFO',
      'message': 'enrichment_completed',
    }),
  ])
