# name: test_telemetry_write_failure_on_periodic_upsert_still_reraises_and_records_failed
  list([
    dict({
      'completed_at_is_set': False,
      'kind': 'progress',
      'progress_data': dict({
        'current_item': '',
        'processed': 0,
        'total': 1,
      }),
      'status': 'running',
      'task_type': 'library_enrichment',
    }),
    dict({
      'category': 'enrichment',
      'details': dict({
        'batch_count': 0,
        'recording_count': 0,
        'release_count': 1,
      }),
      'kind': 'log',
      'level': 'INFO',
      'message': 'enrichment_started',
    }),
    dict({
      'completed_at_is_set': True,
      'kind': 'progress',
      'progress_data': dict({
        'error': 'simulated telemetry write failure',
        'processed': 1,
        'total': 1,
      }),
      'status': 'failed',
      'task_type': 'library_enrichment',
    }),
    dict({
      'category': 'enrichment',
      'details': dict({
        'error': 'simulated telemetry write failure',
        'traceback': '<TRACEBACK>',
      }),
      'kind': 'log',
      'level': 'ERROR',
      'message': 'enrichment_failed',
    }),
  ])
# ---
