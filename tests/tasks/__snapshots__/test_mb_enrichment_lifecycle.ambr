# name: test_telemetry_write_failure_on_periodic_upsert_still_reraises_and_records_failed
  list([
    dict({
      'completed_at_is_set': False,
      'kind': 'progress',
      'progress_data': dict({
        'current_item': '',
        'phase': 'artists',
        'processed': 0,
        'total': 1,
      }),
      'status': 'running',
      'task_type': 'mb_enrichment',
    }),
    dict({
      'category': 'enrichment',
      'details': dict({
        'artists': 1,
        'recordings': 0,
        'works': 0,
      }),
      'kind': 'log',
      'level': 'INFO',
      'message': 'mb_enrichment_started',
    }),
    dict({
      'completed_at_is_set': True,
      'kind': 'progress',
      'progress_data': dict({
        'error': 'simulated telemetry write failure',
        'processed': 1,
        'total': 1,
      }),
      'status': 'failed',
      'task_type': 'mb_enrichment',
    }),
    dict({
      'category': 'enrichment',
      'details': dict({
        'error': 'simulated telemetry write failure',
        'traceback': '<TRACEBACK>',
      }),
      'kind': 'log',
      'level': 'ERROR',
      'message': 'mb_enrichment_failed',
    }),
  ])
# ---
