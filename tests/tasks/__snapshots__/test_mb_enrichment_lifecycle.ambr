# serializer version: 1
# name: test_mid_run_exception_reports_failed_with_partial_progress
  list([
    dict({
      'completed_at_is_set': False,
      'kind': 'progress',
      'progress_data': dict({
        'current_item': '',
        'phase': 'artists',
        'processed': 0,
        'total': 2,
      }),
      'status': 'running',
      'task_type': 'mb_enrichment',
    }),
    dict({
      'category': 'enrichment',
      'details': dict({
        'artists': 2,
        'recordings': 0,
        'works': 0,
      }),
      'kind': 'log',
      'level': 'INFO',
      'message': 'mb_enrichment_started',
    }),
    dict({
      'completed_at_is_set': False,
      'kind': 'progress',
      'progress_data': dict({
        'current_item': 'artist:a0',
        'phase': 'artists',
        'processed': 1,
        'total': 2,
      }),
      'status': 'running',
      'task_type': 'mb_enrichment',
    }),
    dict({
      'completed_at_is_set': True,
      'kind': 'progress',
      'progress_data': dict({
        'error': 'boom mid-run',
        'processed': 1,
        'total': 2,
      }),
      'status': 'failed',
      'task_type': 'mb_enrichment',
    }),
    dict({
      'category': 'enrichment',
      'details': dict({
        'error': 'boom mid-run',
        'traceback': '<TRACEBACK>',
      }),
      'kind': 'log',
      'level': 'ERROR',
      'message': 'mb_enrichment_failed',
    }),
  ])
